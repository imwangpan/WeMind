{
  "name": "mcp-wechat-server",
  "version": "1.0.1",
  "ilink_appid": "bot",
  "description": "MCP Server for WeChat iLink Bot - enables AI agents to send/receive WeChat messages via the Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-wechat-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "wechat",
    "weixin",
    "ai",
    "agent",
    "model-context-protocol",
    "bot"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.1.0"
  }
}
