{
  "name": "@wemind/cli",
  "version": "2.2.0",
  "description": "WeMind — your AI mind, reachable on WeChat. 常驻微信 AI 助手：自动收发 + 远程任务 + 多账号，自带 AI 大脑（任意 ACP agent 可接，默认自动探测）。安装后命令为 wemind。",
  "keywords": [
    "acp",
    "agent",
    "ai",
    "assistant",
    "bot",
    "cli",
    "daemon",
    "wechat",
    "weixin",
    "wemind"
  ],
  "homepage": "https://github.com/imwangpan/WeMind/tree/main/packages/wechat-daemon#readme",
  "bugs": {
    "url": "https://github.com/imwangpan/WeMind/issues"
  },
  "license": "MIT",
  "author": "imwangpan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imwangpan/WeMind.git",
    "directory": "packages/wechat-daemon"
  },
  "bin": {
    "wemind": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --config ../../vitest.config.ts packages/wechat-daemon",
    "test:watch": "vitest --root ../.. --config ../../vitest.config.ts packages/wechat-daemon",
    "dev": "tsx src/cli.ts",
    "prestart": "npm run build",
    "start": "node dist/cli.js start",
    "prepack": "node ../../scripts/prepack-guard.mjs ."
  },
  "dependencies": {
    "silk-wasm": "^3.7.1"
  },
  "devDependencies": {
    "@wemind/wechat-ilink-core": "*",
    "tsdown": "^0.23.7"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
