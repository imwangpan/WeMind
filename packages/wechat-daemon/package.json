    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "wechat",
    "weixin",
    "ai",
    "agent",
    "bot",
    "acp",
    "assistant"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@wemind/wechat-ilink-core": "*",
    "@types/qrcode": "^1.5.5",
    "tsdown": "^0.22.3"
  }
}
