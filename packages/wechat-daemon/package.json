{
  "name": "wemind",
  "version": "1.0.1",
  "description": "WeMind — your AI mind, reachable on WeChat. 常驻微信 AI 助手：自动收发 + 远程任务 + 多账号，自带 AI 大脑（默认 kiro-cli，任意 ACP agent 可接）。",
  "type": "module",
  "bin": {
    "wemind": "dist/cli.js"
  },
