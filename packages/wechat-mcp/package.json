{
  "name": "@wemind/wechat-mcp",
  "version": "1.0.1",
  "description": "MCP server for WeChat iLink Bot - lets any MCP-compatible AI agent send/receive WeChat messages.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wemind-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "mcp",
    "wechat",
    "weixin",
    "ai",
    "agent",
    "model-context-protocol",
    "bot"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@wemind/wechat-ilink-core": "*",
    "tsdown": "^0.22.3"
  }
}
