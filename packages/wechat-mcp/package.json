{
  "name": "@wemind/wechat-mcp",
  "version": "1.1.4",
  "description": "MCP server for WeChat iLink Bot - lets any MCP-compatible AI agent send/receive WeChat messages.",
  "keywords": [
    "agent",
    "ai",
    "bot",
    "mcp",
    "model-context-protocol",
    "wechat",
    "weixin"
  ],
  "homepage": "https://github.com/imwangpan/WeMind/tree/main/packages/wechat-mcp#readme",
  "bugs": {
    "url": "https://github.com/imwangpan/WeMind/issues"
  },
  "license": "MIT",
  "author": "imwangpan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imwangpan/WeMind.git",
    "directory": "packages/wechat-mcp"
  },
  "bin": {
    "wemind-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --config ../../vitest.config.ts packages/wechat-mcp",
    "test:watch": "vitest --root ../.. --config ../../vitest.config.ts packages/wechat-mcp",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "prepack": "node ../../scripts/prepack-guard.mjs ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@wemind/wechat-ilink-core": "*",
    "tsdown": "^0.23.7"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
